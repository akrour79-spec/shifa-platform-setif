# =============================================================================
# بيئة التشغيل الرسمية — منصة شفاء سطيف (Shifa Platform Setif)
# =============================================================================
NODE_ENV=production
PORT=4000

# قاعدة البيانات (PostgreSQL / Supabase Transaction Pooler)
DATABASE_URL=postgres://postgres.xxxx:your_password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require

# جلسات المستخدمين والتشفير
JWT_SECRET=shifa_setif_ultra_secure_jwt_secret_key_2026_prod

# أصول المتصفح المسموحة لـ CORS
CORS_ORIGIN=https://shifa-setif.com

# بوابة الدفع الإلكتروني Chargily Pay v2 (البطاقة الذهبية / CIB)
CHARGILY_SECRET_KEY=secret_key_xxxxxxx
CHARGILY_API_KEY=secret_key_xxxxxxx
CHARGILY_PUBLIC_KEY=public_key_xxxxxxx
CHARGILY_MODE=test # حوّلها لـ live في الإنتاج التجاري

# رابط المنصة المعلن (Domain)
APP_BASE_URL=https://shifa-setif.com
